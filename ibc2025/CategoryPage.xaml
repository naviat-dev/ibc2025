<Page x:Class="ibc2025.CategoryPage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:local="using:ibc2025"
	  x:Name="PageBackground">
	<Grid x:Name="RootGrid"
		  HorizontalAlignment="Stretch"
		  VerticalAlignment="Stretch">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="300"/>
		</Grid.ColumnDefinitions>
		<Grid.RenderTransform>
			<TranslateTransform x:Name="MainTransform"/>
		</Grid.RenderTransform>
		<Grid
			Grid.Column="0"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch">
			<Grid.RowDefinitions>
				<RowDefinition Height="150"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>
			<Grid
				Grid.Row="0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<Image
					Grid.Column="0"
					Source="Assets/mfm-logo.png"
					Margin="10"/>
				<TextBlock
					Grid.Column="1"
					Text="INTERNATIONAL BIBLE QUIZ"
					FontSize="50"
					FontFamily="Bahnschrift"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Margin="10"/>
				<Image
					Grid.Column="2"
					Source="Assets/ibc-logo.png"
					Margin="10"/>
			</Grid>
			<Grid
				Grid.Row="1"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<Button
					x:Name="WisdomsTrueEnding"
					Grid.Column="0"
					FontSize="30"
					FontFamily="Bahnschrift"
					HorizontalAlignment="Stretch"
					HorizontalContentAlignment="Stretch"
					VerticalAlignment="Stretch"
					Margin="10"
					Padding="20,10"
					Click="EnterCategory">
					<StackPanel
						Orientation="Vertical"
						Spacing="8"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Center">
						<TextBlock
							FontSize="100"
							Text="📜"
							HorizontalAlignment="Center"
							TextAlignment="Center"/>
						<TextBlock
							Text="WISDOM'S TRUE ENDING"
							HorizontalAlignment="Stretch"
							TextAlignment="Center"
							TextWrapping="Wrap"/>
						<TextBlock FontSize="20"
								   Text="100 points per question"
								   HorizontalAlignment="Stretch"
								   TextAlignment="Center"
								   TextWrapping="Wrap"/>
						<TextBlock x:Name="WisdomsTrueEndingQuestionCount"
								   FontSize="20"
								   Text="999 questions remaining"
								   HorizontalAlignment="Stretch"
								   TextAlignment="Center"
								   TextWrapping="Wrap"/>
					</StackPanel>
				</Button>
				<Button
					x:Name="WisdomApplied"
					Grid.Column="1"
					FontSize="30"
					FontFamily="Bahnschrift"
					HorizontalAlignment="Stretch"
					HorizontalContentAlignment="Stretch"
					VerticalAlignment="Stretch"
					Margin="10"
					Padding="20,10"
					Click="EnterCategory">
					<StackPanel
						Orientation="Vertical"
						Spacing="8"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Center">
						<TextBlock
							FontSize="100"
							Text="🎯"
							HorizontalAlignment="Center"
							TextAlignment="Center"/>
						<TextBlock
							Text="WISDOM APPLIED"
							HorizontalAlignment="Stretch"
							TextAlignment="Center"
							TextWrapping="Wrap"/>
						<TextBlock FontSize="20"
								   Text="200 points per question"
								   HorizontalAlignment="Stretch"
								   TextAlignment="Center"
								   TextWrapping="Wrap"/>
						<TextBlock x:Name="WisdomAppliedQuestionCount"
								   FontSize="20"
								   Text="999 questions remaining"
								   HorizontalAlignment="Stretch"
								   TextAlignment="Center"
								   TextWrapping="Wrap"/>
					</StackPanel>
				</Button>
				<Button
					x:Name="WordsLeftUnspoken"
					Grid.Column="2"
					FontSize="30"
					FontFamily="Bahnschrift"
					HorizontalAlignment="Stretch"
					HorizontalContentAlignment="Stretch"
					VerticalAlignment="Stretch"
					Margin="10"
					Padding="20,10"
					Click="EnterCategory">
					<StackPanel
						Orientation="Vertical"
						Spacing="8"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Center">
						<TextBlock
							FontSize="100"
							Text="💬"
							HorizontalAlignment="Center"
							TextAlignment="Center"/>
						<TextBlock
							Text="WORDS LEFT UNSPOKEN"
							HorizontalAlignment="Stretch"
							TextAlignment="Center"
							TextWrapping="Wrap"/>
						<TextBlock FontSize="20"
								   Text="300 points per question"
								   HorizontalAlignment="Stretch"
								   TextAlignment="Center"
								   TextWrapping="Wrap"/>
						<TextBlock x:Name="WordsLeftUnspokenQuestionCount"
								   FontSize="20"
								   Text="999 questions remaining"
								   HorizontalAlignment="Stretch"
								   TextAlignment="Center"
								   TextWrapping="Wrap"/>
					</StackPanel>
				</Button>
				<Button
					x:Name="WisdomSays"
					Grid.Column="3"
					FontSize="30"
					FontFamily="Bahnschrift"
					HorizontalAlignment="Stretch"
					HorizontalContentAlignment="Stretch"
					VerticalAlignment="Stretch"
					Margin="10"
					Padding="20,10"
					Click="EnterCategory">
					<StackPanel
						Orientation="Vertical"
						Spacing="8"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Center">
						<TextBlock
							FontSize="100"
							Text="💡"
							HorizontalAlignment="Center"
							TextAlignment="Center"/>
						<TextBlock
							Text="WISDOM SAYS"
							HorizontalAlignment="Stretch"
							TextAlignment="Center"
							TextWrapping="Wrap"/>
						<TextBlock FontSize="20"
								   Text="400 points per question"
								   HorizontalAlignment="Stretch"
								   TextAlignment="Center"
								   TextWrapping="Wrap"/>
						<TextBlock x:Name="WisdomSaysQuestionCount"
								   FontSize="20"
								   Text="999 questions remaining"
								   HorizontalAlignment="Stretch"
								   TextAlignment="Center"
								   TextWrapping="Wrap"/>
					</StackPanel>
				</Button>
				<Button
					x:Name="LocateTheWisdom"
					Grid.Column="4"
					FontSize="30"
					FontFamily="Bahnschrift"
					HorizontalAlignment="Stretch"
					HorizontalContentAlignment="Stretch"
					VerticalAlignment="Stretch"
					Margin="10"
					Padding="20,10"
					Click="EnterCategory">
					<StackPanel
						Orientation="Vertical"
						Spacing="8"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Center">
						<TextBlock
							FontSize="100"
							Text="🔍"
							HorizontalAlignment="Center"
							TextAlignment="Center"/>
						<TextBlock
							Text="LOCATE THE WISDOM"
							HorizontalAlignment="Stretch"
							TextAlignment="Center"
							TextWrapping="Wrap"/>
						<TextBlock FontSize="20"
								   Text="500 points per question"
								   HorizontalAlignment="Stretch"
								   TextAlignment="Center"
								   TextWrapping="Wrap"/>
						<TextBlock x:Name="LocateTheWisdomQuestionCount"
								   FontSize="20"
								   Text="999 questions remaining"
								   HorizontalAlignment="Stretch"
								   TextAlignment="Center"
								   TextWrapping="Wrap"/>
					</StackPanel>
				</Button>
			</Grid>
